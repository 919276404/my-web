            event.target.classList.add('active');
            
            if (module === 'display') {
                document.getElementById('subTabBar').style.display = 'none';
                document.querySelectorAll('.module-content').forEach(c => c.classList.add('hidden'));
                document.getElementById('displayTotal').classList.remove('hidden');
                document.getElementById('pageTitle').textContent = '结果详情';
            } else if (module === 'results') {
                document.getElementById('subTabBar').style.display = 'none';
                document.querySelectorAll('.module-content').forEach(c => c.classList.add('hidden'));
                document.getElementById('resultsTotal').classList.remove('hidden');
                document.getElementById('pageTitle').textContent = '结果列表';
            } else {
                document.getElementById('subTabBar').style.display = 'flex';
                switchSubTab('variety');
            }
        }

        function switchSubTab(subTab) {
            currentSubTab = subTab;
            document.querySelectorAll('.sub-tab').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
            
            document.querySelectorAll('.module-content').forEach(c => c.classList.add('hidden'));
            
            var titleMap = {
                total: { variety: '品类数量设定', region: '区域数量设定', business: '业态数量设定', test: '检验项目设定' },
                evaluation: { variety: '品类数量设定 - 评价抽检', region: '区域数量设定 - 评价抽检', business: '业态数量设定 - 评价抽检', test: '检验项目设定 - 评价抽检' },
