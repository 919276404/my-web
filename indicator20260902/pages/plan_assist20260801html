                                    <option value="食用油、油脂及其制品">食用油、油脂及其制品</option>
                                </select>
                            </div>
                            <div class="filter-item">
                                <label>食品亚类：</label>
                                <select id="filterLevel2" onchange="onLevelChange(2)">
                                    <option value="">全部</option>
                                </select>
                            </div>
                            <div class="filter-item">
                                <label>食品次亚类：</label>
                                <select id="filterLevel3" onchange="onLevelChange(3)">
                                    <option value="">全部</option>
                                </select>
                            </div>
                            <div class="filter-item">
                                <label>食品细类：</label>
                                <select id="filterLevel4">
                                    <option value="">全部</option>
                                </select>
                            </div>
                            <div class="filter-actions">
                                <button class="btn btn-primary" onclick="applyFilter()">筛选</button>
                                <button class="btn btn-secondary" onclick="resetFilter()">重置</button>
                            </div>
                        </div>
                        <div class="table-container">
                            <table class="data-table" id="foodCategoryTable">
                                <thead>
