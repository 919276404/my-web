            };
            
            document.getElementById('pageTitle').textContent = titleMap[currentModule][subTab];
            var contentId = currentModule + subTab.charAt(0).toUpperCase() + subTab.slice(1);
            document.getElementById(contentId).classList.remove('hidden');
        }

        function calcTotalVariety() {
            var total = parseInt(document.getElementById('totalSamples').value) || 50000;
            var inputs = document.querySelectorAll('.ratio-input');
            var cells = document.querySelectorAll('.calc-cell');
            var totalRatio = 0;
            
            inputs.forEach((input, idx) => {
                var ratio = parseFloat(input.value) || 0;
                totalRatio += ratio;
                cells[idx].textContent = Math.round(total * ratio / 100).toLocaleString();
            });
            
            document.getElementById('totalRatio').textContent = totalRatio.toFixed(1) + '%';
            document.getElementById('totalCalc').textContent = Math.round(total * totalRatio / 100).toLocaleString();
        }

        function calcTotalRegion() {
            var adjusts = document.querySelectorAll('.adjust-input');
            var results = document.querySelectorAll('.final-cell');
            var base = [1610, 2525, 7885, 7160, 4615, 1245, 4205, 3025, 5185, 4555, 2995, 895, 1005, 1045, 1205, 790];
            adjusts.forEach((input, idx) => {
                results[idx].textContent = (base[idx] + (parseInt(input.value) || 0)).toLocaleString();
            });
        }

        function calcTotalBusiness() {
            var inputs = document.querySelectorAll('.risk-input');
            var cells = document.querySelectorAll('.biz-cell');
            var total = 50000;
            var basePct = [3.5, 0.2, 1.1, 0.6, 1.5, 4.2, 6.9, 10.9, 0.15, 0.42, 0.11, 0.19, 2.86, 6.94, 15.10, 2.86, 0.69, 0.28];
            inputs.forEach((input, idx) => {
                cells[idx].textContent = Math.round(total * basePct[idx] / 100 * (parseFloat(input.value) || 1)).toLocaleString();
            });
        }

        function calcEvalVariety() {
            var base = parseInt(document.getElementById('evalBase').value) || 100;
        }

        function calcEvalRegion() {
            var total = parseInt(document.getElementById('evalTotal').value) || 50;
            var cells = document.querySelectorAll('.eval-region-cell');
            var perRegion = Math.round(total / 17);
            var remainder = total % 17;
            cells.forEach((cell, idx) => {
                cell.textContent = idx < remainder ? perRegion + 1 : perRegion;
            });
        }

        function toggleTree(id) {
            var icon = document.querySelector('#' + id + ' .expand-icon');
            var children = document.getElementById('child_' + id);
            if (icon && children) {
                icon.classList.toggle('expanded');
                children.classList.toggle('show');
            }
        }

        function handleCategoryCheck(parentId, checkbox) {
            var children = document.getElementById('child_' + parentId);
            if (children) {
                var checkboxes = children.querySelectorAll('.tree-checkbox');
                checkboxes.forEach(cb => {
                    cb.checked = checkbox.checked;
                    cb.dispatchEvent(new Event('change'));
                });
            }
            
            var parentCheckbox = document.getElementById(parentId).parentElement.parentElement.querySelector('.tree-checkbox');
            if (parentCheckbox && parentCheckbox !== checkbox) {
                var siblingCheckboxes = parentCheckbox.parentElement.parentElement.querySelectorAll('.tree-checkbox');
                var allChecked = Array.from(siblingCheckboxes).every(cb => cb.checked);
                var noneChecked = Array.from(siblingCheckboxes).every(cb => !cb.checked);
                if (allChecked) parentCheckbox.checked = true;
                else if (noneChecked) parentCheckbox.checked = false;
            }
        }

        function calculateAll() {
            calcTotalVariety();
            calcTotalRegion();
            calcTotalBusiness();
            calcEvalRegion();
            alert('计划计算完成！');
