                                    <tr><td>粮食加工品</td><td>其他粮食加工品</td><td>谷物加工品</td><td>谷物加工品</td><td>3.1%</td><td><input type="number" class="ratio-input" value="1" onchange="calcTotalVariety()"></td><td class="calc-cell">500</td></tr>
