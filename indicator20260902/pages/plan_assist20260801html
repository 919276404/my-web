                                    <tr><td>粮食加工品</td><td>其他粮食加工品</td><td>谷物碾磨加工品</td><td>米粉</td><td>3.8%</td><td><input type="number" class="ratio-input" value="1" onchange="calcTotalVariety()"></td><td class="calc-cell">500</td></tr>
                                    <tr><td>粮食加工品</td><td>其他粮食加工品</td><td>谷物碾磨加工品</td><td>其他谷物碾磨加工品</td><td>2.9%</td><td><input type="number" class="ratio-input" value="1" onchange="calcTotalVariety()"></td><td class="calc-cell">500</td></tr>
                                    <tr><td>粮食加工品</td><td>其他粮食加工品</td><td>谷物粉类制成品</td><td>生湿面制品</td><td>5.2%</td><td><input type="number" class="ratio-input" value="3" onchange="calcTotalVariety()"></td><td class="calc-cell">1500</td></tr>
                                    <tr><td>粮食加工品</td><td>其他粮食加工品</td><td>谷物粉类制成品</td><td>发酵面制品</td><td>4.8%</td><td><input type="number" class="ratio-input" value="3" onchange="calcTotalVariety()"></td><td class="calc-cell">1500</td></tr>
                                    <tr><td>粮食加工品</td><td>其他粮食加工品</td><td>谷物粉类制成品</td><td>发酵面制品</td><td>4.8%</td><td><input type="number" class="ratio-input" value="3" onchange="calcTotalVariety()"></td><td class="calc-cell">1500</td></tr>
                                    <tr><td>粮食加工品</td><td>其他粮食加工品</td><td>谷物粉类制成品</td><td>米粉制品</td><td>4.1%</td><td><input type="number" class="ratio-input" value="1" onchange="calcTotalVariety()"></td><td class="calc-cell">500</td></tr>
