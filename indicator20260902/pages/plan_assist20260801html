                                <tbody>
                                    <tr><td>东城区</td><td>704789</td><td>3.22%</td><td>1610</td><td><input type="number" class="adjust-input" value="0" onchange="calcTotalRegion()"></td><td class="final-cell">1610</td></tr>
                                    <tr><td>西城区</td><td>1106214</td><td>5.05%</td><td>2525</td><td><input type="number" class="adjust-input" value="0" onchange="calcTotalRegion()"></td><td class="final-cell">2525</td></tr>
