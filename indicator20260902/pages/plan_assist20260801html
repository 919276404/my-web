        function renderTestRiskTable() {
            var allRows = document.querySelectorAll('#testRiskTable tbody tr');
            var matchedRows = Array.from(allRows).filter(row => row.dataset.filterMatch !== 'false');
            var start = (testRiskCurrentPage - 1) * testRiskPageSize;
            var end = start + testRiskPageSize;
            
            allRows.forEach(row => {
                row.style.display = 'none';
            });
            
            matchedRows.forEach((row, index) => {
                if (index >= start && index < end) {
                    row.style.display = '';
                }
            });
        }

        function renderTestRiskPagination() {
            var allRows = document.querySelectorAll('#testRiskTable tbody tr');
            var matchedRows = Array.from(allRows).filter(row => row.dataset.filterMatch !== 'false');
            var totalPages = Math.ceil(matchedRows.length / testRiskPageSize);
            var pageInfo = '共 ' + matchedRows.length + ' 条记录，第 ' + testRiskCurrentPage + '/' + totalPages + ' 页';
            document.getElementById('testRiskPageInfo').textContent = pageInfo;
            
            var pageNumbers = document.getElementById('trPageNumbers');
            pageNumbers.innerHTML = '';
            
            for (var i = 1; i <= totalPages; i++) {
                var span = document.createElement('span');
                span.className = 'pagination-number' + (i === testRiskCurrentPage ? ' active' : '');
                span.textContent = i;
                span.onclick = function() { goToTestRiskPage(parseInt(this.textContent)); };
                pageNumbers.appendChild(span);
            }
            
            document.getElementById('trFirstBtn').disabled = testRiskCurrentPage === 1;
            document.getElementById('trPrevBtn').disabled = testRiskCurrentPage === 1;
            document.getElementById('trNextBtn').disabled = testRiskCurrentPage === totalPages;
            document.getElementById('trLastBtn').disabled = testRiskCurrentPage === totalPages;
            
            document.getElementById('trFirstBtn').onclick = function() { goToTestRiskPage(1); };
            document.getElementById('trLastBtn').onclick = function() { goToTestRiskPage(totalPages); };
        }

